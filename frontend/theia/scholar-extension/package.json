{
  "private": true,
  "name": "@scholar-agent/theia-extension",
  "version": "0.1.0",
  "type": "commonjs",
  "theiaExtensions": [
    {
      "frontend": "lib/theia/scholar-extension/src/browser/scholar-frontend-module"
    }
  ],
  "dependencies": {
    "@theia/core": "1.73.0",
    "@theia/property-view": "1.73.0",
    "clsx": "2.1.1",
    "dagre": "0.8.5",
    "framer-motion": "12.34.0",
    "html-react-parser": "5.2.17",
    "lucide-react": "0.563.0",
    "react-resizable-panels": "4.6.5",
    "reactflow": "11.11.4",
    "tailwind-merge": "3.4.0"
  },
  "peerDependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.18",
    "@types/dagre": "0.7.54",
    "@types/node": "25.2.2",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build:styles": "tailwindcss -i src/browser/style/scholar.css -o lib/theia/scholar-extension/src/browser/style/generated.css --minify",
