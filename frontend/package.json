{
  "name": "frontend",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.cjs",
  "workspaces": [
    "theia/*"
  ],
  "scripts": {
    "bootstrap": "npm ci",
    "dev": "next dev --webpack",
    "dev:web": "next dev --webpack",
    "dev:backend": "uv run --project .. python -m uvicorn backend.app.api.main:app --reload --port 8000 --app-dir .. --reload-dir ../backend --reload-delay 1",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "dev:desktop": "concurrently -k -n backend,frontend,electron -c green,blue,magenta \"npm run dev:backend\" \"npm run dev:web\" \"npm run dev:electron\"",
    "theia:compile": "npm run compile --workspace @scholar-agent/theia-extension",
    "theia:build:browser": "npm run theia:compile && npm run bundle --workspace @scholar-agent/theia-browser",
    "theia:build:electron": "npm run theia:compile && npm run bundle --workspace @scholar-agent/theia-electron",
    "dev:theia:browser": "npm run theia:build:browser && npm run start --workspace @scholar-agent/theia-browser",
    "dev:theia:electron": "npm run theia:build:electron && npm run start --workspace @scholar-agent/theia-electron",
    "dev:theia": "concurrently -k -n backend,theia -c green,blue \"npm run dev:backend\" \"npm run dev:theia:browser\"",
    "dev:theia:desktop": "concurrently -k -n backend,theia -c green,magenta \"npm run dev:backend\" \"npm run dev:theia:electron\"",
    "build": "next build",
    "verify": "npm test -- --run && npm run build && npm run theia:build:browser && npm run theia:build:electron",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "benchmark:kg": "node scripts/benchmark-knowledge-graph.mjs",
    "benchmark:kg:overview": "node scripts/benchmark-knowledge-graph.mjs --nodes 30 --edges 60"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/dagre": "^0.7.54",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "framer-motion": "^12.34.0",
    "html-react-parser": "^5.2.17",
    "lucide-react": "^0.563.0",
    "mathjax-full": "^4.0.0-beta.7",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^4.6.5",
    "reactflow": "^11.11.4",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/cli": "4.1.18",
    "@theia/core": "1.73.0",
    "@theia/electron": "1.73.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.2",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "electron": "39.8.7",
    "happy-dom": "^20.7.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wait-on": "^7.2.0"
  },
  "allowScripts": {
    "drivelist@12.0.2": true,
    "electron@39.8.7": true,
    "@theia/ffmpeg@1.73.0": true
  }
}
