# Anthropic API Key (REQUIRED)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# Source setup: local PostgreSQL (Docker Compose overrides this inside containers)
DATABASE_URL=postgresql://scholaragent:scholaragent@localhost:5432/scholaragent

# Source setup: use the native latexmlc executable (Docker Compose is unaffected)
LATEXML_USE_DOCKER=false

# Knowledge Graph Configuration
# Limit sections processed in knowledge graph (0 = all sections)
KG_MAX_SECTIONS=0

# Enable debug logging for knowledge graph extraction (set to 1 to enable)
KG_DEBUG=

# Debug Flags (set to "true" to enable)
# Enable debug logging for HTML span injection agent
HTML_INJECTION_DEBUG=false

# Enable debug logging for tooltip suggestion agent
TOOLTIP_AGENT_DEBUG=false

# Optional: OpenAI API Key (for future integrations)
OPENAI_API_KEY=

# Optional: LlamaCloud API Key (for future integrations)
LLAMA_CLOUD_API_KEY=
